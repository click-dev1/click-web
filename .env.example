# Override for the absolute site origin (no trailing slash). Only needed
# for a staging host or a domain change — production defaults to
# https://www.clickmedia.group and dev to http://localhost:3000 without
# it. See lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# GA4 Measurement ID (G-XXXXXXXXXX). Public by design — it ships in the
# page. Leave it unset to disable analytics entirely: neither the GA4 tag
# nor HubSpot's tracker is rendered, which is how local dev and preview
# deployments stay out of the property. In Vercel, set it on Production
# only and redeploy — NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sanity — the CMS. Project id and dataset are public by design (they
# ship in the page; the Content Lake is read-only without a token). The
# project lives in CLICK's own Sanity organisation (click-dev1).
NEXT_PUBLIC_SANITY_PROJECT_ID=eclvbmom
NEXT_PUBLIC_SANITY_DATASET=production

# Write token for scripts/seed-sanity.ts only. Never set in Vercel; never
# commit. Create under sanity.io → project → API → Tokens (Editor).
SANITY_API_WRITE_TOKEN=

# Read token (Viewer) — REQUIRED IN EVERY ENVIRONMENT, Production
# included. The dataset is private, so no document can be read without
# it and the build will fail if it is missing. Outside Production it
# also renders draft documents, which is how unpublished content stays
# reviewable without ever being publishable.
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity → Next revalidation webhook
# (app/api/revalidate). Generate any long random string; set the exact
# same value in the webhook definition at manage.sanity.io → API →
# Webhooks. Without it, publishing in the Studio never reaches the site.
SANITY_REVALIDATE_SECRET=

# Render draft documents as well as published ones. Local development
# only — set it to "true" in .env.local and NOWHERE ELSE. Draft reads are
# uncached and untagged, so any deployment that enables this loses
# webhook revalidation entirely: publishing would stop reaching the page.
# A staging deployment must leave this unset so it behaves exactly as
# Production does.
SANITY_PREVIEW_DRAFTS=
